# Application data directory. The Home Assistant add-on mounts this as /data.
CREATOROS_DATA_DIR=./data

# OpenAI API key and optional WebDAV NAS credentials are entered in Settings > Integrationen.
# They are encrypted server-side in this data directory, never in the frontend or this file.
# Back up integrations.key and integrations.vault.json privately for credential recovery.

# Optional shared secret for Home Assistant REST actions. Leave unset for HA ingress only.
HOME_ASSISTANT_SHARED_SECRET=

# Optional Home Assistant REST base URL for event emission outside the add-on.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN is optional; never commit a real token.
HOME_ASSISTANT_TOKEN=
